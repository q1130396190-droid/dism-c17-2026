// file-scope GDI+ bootstrap (shutdown skipped; OS reclaims on exit)
namespace {
struct GdiplusBoot {
    ULONG_PTR m_token;
    GdiplusBoot() {
        Gdiplus::GdiplusStartupInput inp;
        Gdiplus::GdiplusStartup(&m_token, &inp, nullptr);
    }
} g_gdiplusBoot;
}


