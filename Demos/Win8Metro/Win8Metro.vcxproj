       不改变现有 lib/delay-load 链接方式；卫星 DLL 由客户端运行期 LoadLibrary 加载 -->
  <ItemGroup>
    <ProjectReference Include="..\..\DuiLib\DuiLib.vcxproj">
      <Project>{E106ACD7-4E53-4AEE-942B-D0DD426DB34E}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\NCleaner\NCleaner.vcxproj">
      <Project>{C8D3E5F2-9A4B-5C7D-AE6F-3B2A8C9D4E05}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\CBSHost\CBSHost.vcxproj">
      <Project>{B7C2D4E1-8F3A-4B6C-9D5E-2A1F7B8C3D04}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\ActivationKit\ActivationKit.vcxproj">
      <Project>{B7E4D6A1-2C5F-48E9-9D3A-6F1B0C8E5A72}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <!-- Rust dismcore (duilibcalc.dll) 部署：链接使用导入库，运行时 DLL 必须与 exe 同目录/在 bin64，
       否则新增 FFI 导出会在启动时报“无法定位程序输入点”。每次构建后同步 release DLL。 -->
  <Target Name="DeployDismCoreRuntime" AfterTargets="Build">
    <PropertyGroup>
      <DismCoreDllPath>$(ProjectDir)../../rust/dismcore/target/release/duilibcalc.dll</DismCoreDllPath>
      <DismCoreDstDir>$(ProjectDir)../../bin64/amd64</DismCoreDstDir>
    </PropertyGroup>
    <Error Text="Rust runtime duilibcalc.dll 未找到，请先执行 cargo build --release" Condition="!Exists('$(DismCoreDllPath)')" />
    <Copy SourceFiles="$(DismCoreDllPath)" DestinationFolder="$(DismCoreDstDir)" SkipUnchangedFiles="true" />
  </Target>
  <!-- [MIG] Deploy the framework runtime DLL that matches this configuration.
       Win8Metro delay-loads DuiLib.dll / DuiLib_d.dll from <exe>\amd64\, and the
       loader hook in Win8Metro.cpp only searches there and <exe>\. Without this copy
       the Debug binary aborts before WinMain with "cannot find DuiLib_d.dll". -->
  <Target Name="DeployFrameworkRuntime" AfterTargets="Build">
    <PropertyGroup>
      <FrameworkDllName Condition="'$(Configuration)'=='Debug'">DuiLib_d.dll</FrameworkDllName>
      <FrameworkDllName Condition="'$(Configuration)'!='Debug'">DuiLib.dll</FrameworkDllName>
      <FrameworkDllSrc>$(SolutionDir)Bin\$(Platform)\$(FrameworkDllName)</FrameworkDllSrc>
      <FrameworkDllDst>$(ProjectDir)..\..\bin64\amd64</FrameworkDllDst>
    </PropertyGroup>
    <!-- [PORTABLE-FIX 2026-11-01] 解决方案的 SRelease/SDebug 配置把 DuiLib 编译为
         静态库（ConfigurationType=StaticLibrary），此时 Bin\<Platform>\ 下根本不会
         产生 DuiLib.dll，原先的 Error 会让便携版构建必然失败。
         改为：DLL 存在才复制；不存在只告警——静态链接下运行时本就不需要它。
         真正的 DLL 缺失（Release/Debug 配置忘了先编 DuiLib）仍由告警暴露。 -->
    <Warning Text="[MIG] 框架运行时 $(FrameworkDllName) 未找到（$(Configuration)|$(Platform)）：若本次为 S* 静态配置则属正常，DuiLib 已静态链接；否则请先构建 DuiLib\DuiLib.vcxproj"
             Condition="!Exists('$(FrameworkDllSrc)')" />
    <Copy SourceFiles="$(FrameworkDllSrc)" DestinationFolder="$(FrameworkDllDst)" SkipUnchangedFiles="true"
          Condition="Exists('$(FrameworkDllSrc)')" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
