<?xml version="1.0" encoding="utf-8"?>
<Window>
<VerticalLayout name="page_assoc" bkcolor="#FFFFFFFF" inset="14,14,14,14" childpadding="14">
          <!-- R33: 顶部搜索工具条 -->
          <HorizontalLayout name="cl_15" height="34" childpadding="8" childvalign="vcenter" bkcolor="#FFEFF6FC" inset="6,2,6,2">
            <Text text="搜索" font="1" textcolor="#FF333333" width="48" valign="vcenter"/>
            <Edit name="assoc_filter" width="0" height="28" tipvalue="输入扩展名或 ProgId 过滤（如 .txt / notepad）" tipvaluecolor="#FF999999" textcolor="#FF1A1A1A" font="1" bkcolor="#FFFFFFFF" bordercolor="#FFABABAB" bordersize="1" textpadding="6,4,6,4"/>
            <Text name="lbl_assoc_count" text="" font="1" textcolor="#FF666666" autocalcwidth="true" valign="vcenter"/>
            <Control width="0"/>
            <Button name="btn_assoc_openwith" text="打开方式" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" borderround="4,4" pushedbkcolor="#FF005A9E" height="26" width="90"/>
          </HorizontalLayout>

          <!-- offline image associations -->
          <VerticalLayout name="assoc_group_img" height="0" bkcolor="#FFFFFFFF" bordercolor="#FFABABAB" bordersize="1" inset="20,16,18,14" childpadding="8">
            <Text name="lbl_as_imgtitle" text="Windows映像默认应用程序关联" font="4" textcolor="#FF1A1A1A" height="30"/>
            <Text name="lbl_as_imgdesc" text="这些设置将在首次启动计算机的OOBE阶段生效" font="1" textcolor="#FF333333" height="26"/>
            <VerticalLayout name="assoc_img_list" width="0" height="0" bkcolor="#FFFFFFFF" childpadding="0" vscrollbar="true"/>
            <HorizontalLayout name="cl_16" height="46" childpadding="10" childvalign="vcenter">
              <Control width="0"/>
              <Button name="btn_assoc_img_import" text="导入" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF" hotbkcolor="#FFE5F1FB" pushedbkcolor="#FFCCE4F7" bordercolor="#FFABABAB" bordersize="1" width="118" height="40" align="center" valign="center"/>
              <Button name="btn_assoc_img_export" text="导出" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF" hotbkcolor="#FFE5F1FB" pushedbkcolor="#FFCCE4F7" bordercolor="#FFABABAB" bordersize="1" width="118" height="40" align="center" valign="center"/>
              <Button name="btn_assoc_img_delete" text="删除" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF" hotbkcolor="#FFE5F1FB" pushedbkcolor="#FFCCE4F7" bordercolor="#FFABABAB" bordersize="1" width="118" height="40" align="center" valign="center"/>
            </HorizontalLayout>
          </VerticalLayout>

          <!-- online image associations -->
          <VerticalLayout name="assoc_group_live" height="0" bkcolor="#FFFFFFFF" bordercolor="#FFABABAB" bordersize="1" inset="20,16,18,14" childpadding="8">
            <Text name="lbl_as_livetitle" text="Windows联机映像默认应用程序关联" font="4" textcolor="#FF1A1A1A" height="30"/>
            <Text name="lbl_as_livedesc" text="这些设置直接影响当前计算机" font="1" textcolor="#FF333333" height="26"/>
            <VerticalLayout name="assoc_live_list" width="0" height="0" bkcolor="#FFFFFFFF" childpadding="0" vscrollbar="true"/>
            <HorizontalLayout name="cl_17" height="26" childpadding="12">
              <Text name="assoc_progid" text="ProgId：（选择上方扩展名后显示）" font="1" textcolor="#FF333333" width="0" valign="vcenter" endellipsis="true"/>
              
              <Button name="btn_assoc_batch_apply" text="批量应用" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" borderround="4,4" pushedbkcolor="#FF005A9E" height="26" width="80"/><Text name="assoc_cmd" text="打开命令：" font="1" textcolor="#FF666666" width="0" valign="vcenter" endellipsis="true"/>
            </HorizontalLayout>
            <HorizontalLayout name="cl_18" height="46" childpadding="10" childvalign="vcenter">
              <Control width="0"/>
              <Button name="btn_assoc_live_import" text="导入" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF" hotbkcolor="#FFE5F1FB" pushedbkcolor="#FFCCE4F7" bordercolor="#FFABABAB" bordersize="1" width="118" height="40" align="center" valign="center"/>
              <Button name="btn_assoc_live_export" text="导出" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF" hotbkcolor="#FFE5F1FB" pushedbkcolor="#FFCCE4F7" bordercolor="#FFABABAB" bordersize="1" width="118" height="40" align="center" valign="center"/>
              <Button name="btn_assoc_live_reset" text="重置" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF" hotbkcolor="#FFE5F1FB" pushedbkcolor="#FFCCE4F7" bordercolor="#FFABABAB" bordersize="1" width="118" height="40" align="center" valign="center"/>
            </HorizontalLayout>
          </VerticalLayout>
        </VerticalLayout>
</Window>
