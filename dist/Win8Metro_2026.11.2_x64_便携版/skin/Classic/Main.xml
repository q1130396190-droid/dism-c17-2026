  <Default name="VScrollBar" value="width=&quot;10&quot; showbutton1=&quot;false&quot; showbutton2=&quot;false&quot; thumbbkcolor=&quot;#FFABABAB&quot; railbkcolor=&quot;#00000000&quot; thumbhotbkcolor=&quot;#FF999999&quot; thumbpushedbkcolor=&quot;#FF787878&quot;" />

