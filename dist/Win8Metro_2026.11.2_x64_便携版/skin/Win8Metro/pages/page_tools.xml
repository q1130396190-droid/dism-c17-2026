<?xml version="1.0" encoding="utf-8"?>
<Window>
<VerticalLayout name="page_tools" inset="24,22,24,8" childpadding="0">
          
          <!-- [R107] 工具箱统一进度条：轮询 progress.txt 显示工具运行状态 -->
          <HorizontalLayout name="tools_progress_row" height="28" visible="false">
            <Progress name="tools_progress" min="0" max="100" value="0" height="8" width="180" bkcolor="{tok:SurfaceSunk}" forecolor="{tok:Accent}" showtext="false" visible="false" borderround="4,4"/>
            <Text name="tools_progress_label" width="0" height="0" font="1" textcolor="{tok:AccentText}" align="left" valign="vcenter" visible="false"/>
          </HorizontalLayout>

          <!-- [R110] 工具筛选 + 刷新 + 计数：D1 核心操作"过滤/刷新"补齐 -->
          <HorizontalLayout name="page_tools_L12" height="30" bkcolor="{tok:SurfaceSunk}" childvalign="vcenter" borderround="8,8">
            <Text name="lbl_tools_title" text="工具箱" font="6" textcolor="{tok:Ink}" width="120" align="center"/>
            <Control width="8" height="1"/>
            <!-- [R119-1] 分类筛选：全部 / 系统 / 磁盘镜像 / 系统工具 -->
            <Combo name="tools_cat_filter" width="120" height="32" font="1" textcolor="{tok:Ink}" bkcolor="{tok:SurfaceSunk}" bordercolor="{tok:Border}" bordersize="1" itemtextcolor="{tok:Ink}" itembkcolor="{tok:SurfaceSunk}" itemselectedtextcolor="{tok:OnAccent}" itemselectedbkcolor="{tok:Accent}" itemhotbkcolor="{tok:SurfaceHover}" itemfont="1" itemalign="left" itemvalign="vcenter" itemendellipsis="true" itemtextpadding="8,3,8,3" borderround="4,4"/>
            <Control width="8" height="1"/>
            <Edit name="tools_filter" width="0" height="32" textcolor="{tok:Ink}" tipvalue="输入名称过滤工具（如 备份 / 还原 / ESD）" tipvaluecolor="{tok:InkMuted}" font="1" bkcolor="{tok:Surface}" bordercolor="{tok:Border}" bordersize="1" textpadding="6,4,6,4" borderround="4,4"/>
            <Control width="8" height="1"/>
            <Button name="btn_tools_refresh" text="刷新" font="1" textcolor="{tok:Ink}" bkcolor="{tok:AccentSoft}" bordercolor="{tok:AccentBorder}" bordersize="1" width="56" height="32" borderround="4,4"/>
            <Control width="8" height="1"/>
            <Text name="tools_count" text="11 个工具" width="0" height="0" font="1" textcolor="{tok:Ink}" align="left" valign="vcenter"/>
          </HorizontalLayout>

          <!-- [U-3] itemsize 高 200→178：风险徽章已移除，与 BpBuildCard nItemH 同步 -->
          <TileLayout name="tools_grid" width="0" height="0" childpadding="8" itemsize="160,178"/>
        </VerticalLayout>
</Window>
