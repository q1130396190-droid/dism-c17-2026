<?xml version="1.0" encoding="utf-8"?>
<Window>
<VerticalLayout name="page_unattend" bkcolor="{tok:Surface}" inset="0,0,0,0" childpadding="0" borderround="8,8">
          <VerticalLayout name="uc_groups" width="0" height="0" bkcolor="{tok:Surface}" childpadding="0" vscrollbar="true" borderround="8,8"/>
          <HorizontalLayout name="page_unattend_L5" height="56" bkcolor="{tok:Surface}" inset="14,0,14,0" childpadding="10" childvalign="vcenter" borderround="8,8">
            <Edit name="uc_edit" width="0" height="32" tipvalue="请在此输入需要添加的命令" font="1" bkcolor="{tok:Surface}" bordercolor="{tok:Border}" bordersize="1" textpadding="8,5,8,5" borderround="4,4"/>
            <Button name="btn_uc_add" text="添加" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="104" height="32" align="center" valign="center" borderround="4,4"/>
            <Button name="btn_uc_up" text="上移" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="104" height="32" align="center" valign="center" borderround="4,4"/>
            <Button name="btn_uc_del" text="删除" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="104" height="32" align="center" valign="center" borderround="4,4"/>
            <!-- [R71] Sysprep 流程 + IBSProvider + 应用预应答 -->
            <Button name="btn_uc_apply" text="应用" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="104" height="32" align="center" valign="center" borderround="4,4"/>
            <Button name="btn_sysprep" text="Sysprep" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="104" height="32" align="center" valign="center" borderround="4,4"/>
            <Button name="btn_ibs" text="IBS报告" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="104" height="32" align="center" valign="center" borderround="4,4"/>
          </HorizontalLayout>
          <HorizontalLayout name="page_unattend_L15" height="48" bkcolor="{tok:Surface}" inset="14,0,14,0" childpadding="10" childvalign="vcenter" borderround="8,8">
            <Text name="lbl_uc_status" width="0" height="0" font="1" textcolor="{tok:InkTertiary}" align="left"/>
            <Control width="0"/>
            <Button name="btn_uc_import" text="导入XML" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="104" height="32" align="center" valign="center" borderround="4,4"/>
            <Button name="btn_uc_export" text="导出XML" font="1" textcolor="{tok:OnAccent}" bkcolor="{tok:Accent}" hotbkcolor="{tok:AccentHot}" borderround="4,4" pushedbkcolor="{tok:AccentPushed}" width="104" height="32" align="center" valign="center"/>
          </HorizontalLayout>
        </VerticalLayout>
</Window>
