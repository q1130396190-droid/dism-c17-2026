<?xml version="1.0" encoding="utf-8"?>
<Window>
<VerticalLayout name="page_feature" bkcolor="{tok:Surface}" inset="22,8,18,0" childpadding="0" borderround="8,8">
          <!-- [R30] 顶部工具条：分类 + 搜索 + /Source 输入 + 浏览 -->
          <!-- [R200] 分类下拉框（cap_cat_combo）项由 AxInitSmartCombo 填充，
               不写死 XML 文本；同一数据源同时受 Windows 版本分级影响。 -->
          <HorizontalLayout name="page_feature_L7" height="36" childpadding="4" childvalign="vcenter" bkcolor="{tok:Surface}" borderround="8,8">
            <Combo name="cap_cat_combo" width="124" height="32" font="1" textcolor="{tok:Ink}" bkcolor="{tok:SurfaceSunk}" bordercolor="{tok:Border}" bordersize="1" itemtextcolor="{tok:Ink}" itembkcolor="{tok:SurfaceSunk}" itemselectedtextcolor="{tok:OnAccent}" itemselectedbkcolor="{tok:Accent}" itemhotbkcolor="{tok:SurfaceHover}" itemfont="1" itemalign="left" itemvalign="vcenter" itemendellipsis="true" itemtextpadding="8,3,8,3" borderround="4,4"/>
            <Text text="搜索" font="1" textcolor="{tok:Ink}" width="46" valign="vcenter"/>
            <Edit name="cap_filter_edit" width="0" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" tipvalue="输入关键字过滤" tipvaluecolor="{tok:InkMuted}" bordersize="1" bordercolor="{tok:Border}" height="32" textpadding="6,4,6,4" borderround="4,4"/>
            <Text text="本地源" font="1" textcolor="{tok:Ink}" width="52" valign="vcenter"/>
            <Edit name="cap_source_edit" width="0" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" tipvalue="可选：ISO/SxS 本地源路径" tipvaluecolor="{tok:InkMuted}" bordersize="1" bordercolor="{tok:Border}" height="32" textpadding="6,4,6,4" borderround="4,4"/>
            <Button name="btn_cap_browse" text="浏览" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordersize="1" bordercolor="{tok:Border}" width="76" height="32" borderround="4,4"/>
          </HorizontalLayout>
<VerticalLayout name="cap_list" width="0" height="0" bkcolor="{tok:Surface}" childpadding="0" vscrollbar="true" borderround="8,8"/>
          <!-- [R73] FOD 状态可视化：安装进度 + 依赖统计（独立状态行，避免与底栏挤压重叠） -->
          <HorizontalLayout name="page_feature_L17" height="40" bkcolor="{tok:SurfaceAlt}" childpadding="8" childvalign="vcenter" borderround="8,8">
            <Text text="状态概览" font="1" textcolor="{tok:Ink}" width="72" valign="vcenter"/>
            <Text name="lbl_cap_visual" text="" font="1" textcolor="{tok:Ink}" width="0" valign="vcenter" endellipsis="true"/>
            <Progress name="cap_visual_progress" min="0" max="100" value="0" width="180" height="14" bkcolor="{tok:SurfaceSunk}" forecolor="{tok:Accent}" showtext="false" borderround="4,4"/>
          </HorizontalLayout>
          <HorizontalLayout height="42" childvalign="vcenter" childpadding="8">
            <BoxCheck name="cap_showall" text="显示所有功能" font="1" textcolor="{tok:Ink}" borderround="4,4"/>
            <Control width="0"/>
            <Button name="btn_cap_refresh" text="刷新" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordersize="1" bordercolor="{tok:Border}" width="88" height="32" align="center" valign="center" borderround="4,4"/>
          </HorizontalLayout>
        </VerticalLayout>
</Window>
