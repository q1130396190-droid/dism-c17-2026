<?xml version="1.0" encoding="utf-8"?>
<Window>
<VerticalLayout name="page_update" bkcolor="#FFFFFFFF" inset="0,0,0,0" childpadding="0">
          <!-- tabs -->
          <HorizontalLayout name="cl_73" height="58" bkcolor="#FFFFFFFF" inset="380,0,0,0" childvalign="vcenter">
            <Option name="updtab_0" group="upd_tab" text="Windows Update" font="5" textcolor="#FF666666" selectedtextcolor="#FF007ACC" bkcolor="#00000000" width="250" height="58" align="left"/>
            <Option name="updtab_1" group="upd_tab" text="已安装的更新" font="5" textcolor="#FF666666" selectedtextcolor="#FF007ACC" bkcolor="#00000000" width="210" height="58" align="left" selected="true"/>
            <Control width="0"/>
          </HorizontalLayout>

          <!-- R37: 顶部搜索工具条 -->
          <HorizontalLayout name="cl_74" height="32" bkcolor="#FFEFF6FC" inset="6,4,6,4" childpadding="8" childvalign="vcenter">
            <Text text="搜索" font="1" textcolor="#FF333333" width="48" valign="vcenter"/>
            <Edit name="upd_filter" width="0" height="28" tipvalue="输入更新标题关键字过滤（不区分大小写）" tipvaluecolor="#FF999999" textcolor="#FF1A1A1A" font="1" bkcolor="#FFFFFFFF" bordercolor="#FFABABAB" bordersize="1" textpadding="6,4,6,4"/>
            <Text name="lbl_upd_count" text="" font="1" textcolor="#FF666666" autocalcwidth="true" valign="vcenter"/>
            <Text text="下载线程" font="1" textcolor="#FF666666" width="70" valign="vcenter"/>
            <Combo name="upd_maxthread_combo" width="80" height="24" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF"/>
          </HorizontalLayout>

          <TabLayout name="upd_pages" width="0" height="0">
            <!-- 0: Windows Update (待安装) -->
            <VerticalLayout name="cl_75" bkcolor="#FFFFFFFF" childpadding="0">
              <HorizontalLayout name="cl_76" height="34" bkcolor="#FFEFF6FC">
                <Text name="hdr_wu_item" text="项目" font="6" textcolor="#FF333333" width="0" align="left" valign="vcenter" textpadding="10,0,0,0"/>
                <Text name="hdr_wu_date" text="安装日期" font="6" textcolor="#FF333333" width="240" align="center" valign="vcenter"/>
                <Text name="hdr_wu_status" text="状态" font="6" textcolor="#FF333333" width="150" align="center" valign="vcenter"/>
              </HorizontalLayout>
              <Text name="upd_wu_hint" width="0" height="0" font="2" textcolor="#FF666666" align="center"/>
              <VerticalLayout name="upd_pending_list" width="0" height="0" bkcolor="#FFFFFFFF" childpadding="0" vscrollbar="true"/>
            </VerticalLayout>
            <!-- 1: installed updates -->
            <VerticalLayout name="cl_77" bkcolor="#FFFFFFFF" childpadding="0">
              <HorizontalLayout name="cl_78" height="34" bkcolor="#FFEFF6FC">
                <Text name="hdr_wu_item2" text="项目" font="6" textcolor="#FF333333" width="0" align="left" valign="vcenter" textpadding="10,0,0,0"/>
                <Text name="hdr_wu_date2" text="安装日期" font="6" textcolor="#FF333333" width="240" align="center" valign="vcenter"/>
                <Text name="hdr_wu_status2" text="状态" font="6" textcolor="#FF333333" width="150" align="center" valign="vcenter"/>
              </HorizontalLayout>
              <VerticalLayout name="upd_list" width="0" height="0" bkcolor="#FFFFFFFF" childpadding="0" vscrollbar="true"/>
            </VerticalLayout>
          </TabLayout>

          <!-- bottom bar [按钮整合] 暂停/恢复、推迟/恢复功能更新、禁用/恢复系统更新
               各合并为单一切换键（文案/配色随策略状态切换），总宽压至约 1200px，
               非全屏 1280 宽也能完整显示 -->
          <HorizontalLayout name="cl_79" height="54" bkcolor="#FFFFFFFF" inset="14,0,14,0" childpadding="8" childvalign="vcenter">
            <Button name="btn_upd_find" text="查找" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF" hotbkcolor="#FFE5F1FB" pushedbkcolor="#FFCCE4F7" bordercolor="#FFABABAB" bordersize="1" width="85" height="38" align="center" valign="center"/>
            <Control width="0"/>
            <Button name="btn_upd_refresh" text="刷新" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF" hotbkcolor="#FFE5F1FB" pushedbkcolor="#FFCCE4F7" bordercolor="#FFABABAB" bordersize="1" width="85" height="38" align="center" valign="center"/>
            <Button name="btn_upd_selall" text="全选" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" pushedbkcolor="#FF005A9E" borderround="4,4" height="30" width="70"/>
            <Button name="btn_upd_delete" text="删除" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" borderround="4,4" pushedbkcolor="#FF005A9E" width="90" height="38" align="center" valign="center"/>
            <!-- R74: 三阶段更新流（PreDownload / Install / Finalize） -->
            <Button name="btn_upd_predownload" text="预下载" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF" hotbkcolor="#FFE5F1FB" pushedbkcolor="#FFCCE4F7" bordercolor="#FFABABAB" bordersize="1" width="85" height="38" align="center" valign="center"/>
            <Button name="btn_upd_install" text="安装" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" borderround="4,4" pushedbkcolor="#FF005A9E" width="80" height="38" align="center" valign="center"/>
            <Button name="btn_upd_finalize" text="完成" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" borderround="4,4" pushedbkcolor="#FF005A9E" width="80" height="38" align="center" valign="center"/>
            <!-- [R82] P0-5 隐藏/取消隐藏更新（作用对象不同，保留两键） -->
            <Button name="btn_upd_hide" text="隐藏" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF" hotbkcolor="#FFE5F1FB" pushedbkcolor="#FFCCE4F7" bordercolor="#FFABABAB" bordersize="1" width="80" height="38" align="center" valign="center"/>
            <Button name="btn_upd_unhide" text="取消隐藏" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF" hotbkcolor="#FFE5F1FB" pushedbkcolor="#FFCCE4F7" bordercolor="#FFABABAB" bordersize="1" width="100" height="38" align="center" valign="center"/>
            <!-- [R86 P1-18 + 按钮整合] 暂停/恢复自动更新：同一个键，再点切换 -->
            <Button name="btn_upd_pausetoggle" text="暂停更新" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF" hotbkcolor="#FFE5F1FB" pushedbkcolor="#FFCCE4F7" bordercolor="#FFABABAB" bordersize="1" width="100" height="38" align="center" valign="center"/>
            <!-- [R86 P1-18 + 按钮整合] 推迟/恢复功能更新：同一个键，再点切换 -->
            <Button name="btn_upd_skiptoggle" text="推迟功能更新" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF" hotbkcolor="#FFE5F1FB" pushedbkcolor="#FFCCE4F7" bordercolor="#FFABABAB" bordersize="1" width="115" height="38" align="center" valign="center"/>
            <!-- [R-B49 + 按钮整合] 禁用/恢复系统更新：同一个键；危险方向红色，已禁用恢复时为白底 -->
            <Button name="btn_upd_disabletoggle" text="禁用系统更新" font="1" textcolor="#FFFFFFFF" bkcolor="#FFE23A3E" hotbkcolor="#FFE74C3C" borderround="4,4" pushedbkcolor="#FF96281B" width="120" height="38" align="center" valign="center"/>
            <!-- [性能 P3] 策略下拉：折叠暂停/推迟/禁用三枚切换键，点击弹状态菜单 -->
            <!-- [R216] 安装状态行：Page_Update.cpp 有 4 处往这个控件写状态，
                 Classic 皮肤原本没有它 → 安装进度完全不可见。 -->
            <Text name="upd_install_state" text="" font="1" textcolor="#FF666666" width="0" height="38" align="left" valign="vcenter" endellipsis="true"/>
            <Button name="btn_upd_policy" text="策略▾" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF" hotbkcolor="#FFE5F1FB" pushedbkcolor="#FFCCE4F7" bordercolor="#FFABABAB" bordersize="1" width="110" height="38" align="center" valign="center"/>
          </HorizontalLayout>
        </VerticalLayout>
</Window>
