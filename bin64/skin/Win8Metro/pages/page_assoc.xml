<?xml version="1.0" encoding="utf-8"?>
<Window>
<VerticalLayout name="page_assoc" bkcolor="{tok:Surface}" inset="14,14,14,14" childpadding="14" borderround="8,8">
          <!-- R33: 顶部搜索工具条 -->
          <HorizontalLayout name="page_assoc_L5" height="34" childpadding="8" childvalign="vcenter" bkcolor="{tok:SurfaceAlt}" inset="6,2,6,2" borderround="8,8">
            <Text text="搜索" font="1" textcolor="{tok:Ink}" width="48" valign="vcenter"/>
            <Edit name="assoc_filter" width="0" height="32" tipvalue="输入扩展名或 ProgId 过滤（如 .txt / notepad）" tipvaluecolor="{tok:InkMuted}" textcolor="{tok:Ink}" font="1" bkcolor="{tok:Surface}" bordercolor="{tok:Border}" bordersize="1" textpadding="6,4,6,4" borderround="4,4"/>
            <Text name="lbl_assoc_count" text="" font="1" textcolor="{tok:InkTertiary}" autocalcwidth="true" valign="vcenter"/>
            <Control width="0"/>
            <Button name="btn_assoc_openwith" text="打开方式" font="1" textcolor="{tok:OnAccent}" bkcolor="{tok:Accent}" hotbkcolor="{tok:AccentHot}" borderround="4,4" pushedbkcolor="{tok:AccentPushed}" height="32" width="90"/>
          </HorizontalLayout>

          <!-- offline image associations -->
          <VerticalLayout name="assoc_group_img" height="0" bkcolor="{tok:Surface}" bordercolor="{tok:InkMuted}" bordersize="1" inset="20,16,18,14" childpadding="8" borderround="8,8">
            <Text name="lbl_as_imgtitle" text="Windows映像默认应用程序关联" font="4" textcolor="{tok:Ink}" height="30"/>
            <Text name="lbl_as_imgdesc" text="这些设置将在首次启动计算机的OOBE阶段生效" font="1" textcolor="{tok:InkSecondary}" height="26"/>
            <VerticalLayout name="assoc_img_list" width="0" height="0" bkcolor="{tok:Surface}" childpadding="0" vscrollbar="true" borderround="8,8"/>
            <HorizontalLayout height="46" childpadding="10" childvalign="vcenter">
              <Control width="0"/>
              <Button name="btn_assoc_img_import" text="导入" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="104" height="40" align="center" valign="center" borderround="4,4"/>
              <Button name="btn_assoc_img_export" text="导出" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="104" height="40" align="center" valign="center" borderround="4,4"/>
              <Button name="btn_assoc_img_delete" text="删除" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="104" height="40" align="center" valign="center" borderround="4,4"/>
            </HorizontalLayout>
          </VerticalLayout>

          <!-- online image associations -->
          <VerticalLayout name="assoc_group_live" height="0" bkcolor="{tok:Surface}" bordercolor="{tok:InkMuted}" bordersize="1" inset="20,16,18,14" childpadding="8" borderround="8,8">
            <Text name="lbl_as_livetitle" text="Windows联机映像默认应用程序关联" font="4" textcolor="{tok:Ink}" height="30"/>
            <Text name="lbl_as_livedesc" text="这些设置直接影响当前计算机" font="1" textcolor="{tok:InkSecondary}" height="26"/>
            <VerticalLayout name="assoc_live_list" width="0" height="0" bkcolor="{tok:Surface}" childpadding="0" vscrollbar="true" borderround="8,8"/>
            <HorizontalLayout height="26" childpadding="12">
              <Text name="assoc_progid" text="ProgId：（选择上方扩展名后显示）" font="1" textcolor="{tok:Ink}" width="0" valign="vcenter" endellipsis="true"/>
              
              <Button name="btn_assoc_batch_apply" text="批量应用" font="1" textcolor="{tok:OnAccent}" bkcolor="{tok:Accent}" hotbkcolor="{tok:AccentHot}" borderround="4,4" pushedbkcolor="{tok:AccentPushed}" height="32" width="80"/><Text name="assoc_cmd" text="打开命令：" font="1" textcolor="{tok:InkTertiary}" width="0" valign="vcenter" endellipsis="true"/>
            </HorizontalLayout>
            <HorizontalLayout height="46" childpadding="10" childvalign="vcenter">
              <Control width="0"/>
              <Button name="btn_assoc_live_import" text="导入" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="104" height="40" align="center" valign="center" borderround="4,4"/>
              <Button name="btn_assoc_live_export" text="导出" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="104" height="40" align="center" valign="center" borderround="4,4"/>
              <Button name="btn_assoc_live_reset" text="重置" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="104" height="40" align="center" valign="center" borderround="4,4"/>
            </HorizontalLayout>
          </VerticalLayout>
        </VerticalLayout>
</Window>
