<?xml version="1.0" encoding="utf-8"?>
<Window>
<VerticalLayout name="page_startup" inset="0,0,0,0" childpadding="0">

          <!-- tab row -->
          <HorizontalLayout name="page_startup_L6" height="40" bkcolor="{tok:Surface}" inset="16,0,0,0" childpadding="24" childvalign="vcenter" borderround="8,8">
            <Option name="sttab_0" group="st_tab" text="开机启动项" font="2" textcolor="{tok:InkTertiary}" selectedtextcolor="{tok:AccentText}" bkcolor="#00000000" width="120" height="40" align="left" selected="true"/>
            <Option name="sttab_1" group="st_tab" text="服务项" font="2" textcolor="{tok:InkTertiary}" selectedtextcolor="{tok:AccentText}" bkcolor="#00000000" width="120" height="40" align="left"/>
                <Option name="sttab_2" group="st_tab" text="计划任务" font="2" textcolor="{tok:InkTertiary}" selectedtextcolor="{tok:AccentText}" bkcolor="#00000000" width="120" height="40" align="left"/>
          </HorizontalLayout>
          <Control height="1" bkcolor="{tok:BorderSoft}"/>

          <!-- R35: 顶部搜索工具条 -->
          <HorizontalLayout name="page_startup_L14" height="34" bkcolor="{tok:SurfaceAlt}" inset="16,4,16,4" childpadding="8" childvalign="vcenter" borderround="8,8">
            <Text text="搜索" font="1" textcolor="{tok:InkSecondary}" width="48" valign="vcenter"/>
            <Edit name="startup_filter" width="0" height="32" tipvalue="输入名称或路径过滤（不区分大小写）" tipvaluecolor="{tok:InkMuted}" textcolor="{tok:Ink}" font="1" bkcolor="{tok:Surface}" bordercolor="{tok:Border}" bordersize="1" textpadding="6,4,6,4" borderround="4,4"/>
            <Text name="lbl_startup_count" text="" font="1" textcolor="{tok:InkTertiary}" autocalcwidth="true" valign="vcenter"/>
          </HorizontalLayout>

          <!-- [D1] 启动项/服务统计信息条（切 tab 时由代码刷新文案） -->
          <Text name="startup_infobar" text="" font="1" textcolor="{tok:AccentText}" bkcolor="{tok:SurfaceAlt}" height="26" align="left" valign="vcenter" textpadding="16,4,8,4" endellipsis="true"/>

          <TabLayout name="startup_pages" width="0" height="0">

            <!-- boot-start items -->
            <VerticalLayout inset="14,6,14,0" childpadding="0">
              <VerticalLayout name="startup_list" width="0" height="0" bkcolor="{tok:Surface}" childpadding="0" vscrollbar="true" borderround="8,8"/>
            </VerticalLayout>

            <!-- services -->
            <VerticalLayout inset="14,6,14,0" childpadding="0">
              <HorizontalLayout name="page_startup_L32" height="28" bkcolor="{tok:SurfaceSunk}" childvalign="vcenter" borderround="8,8">
                <Text name="hdr_su_service" text="服务" font="6" textcolor="{tok:Ink}" width="240" align="center"/>
                <Text name="hdr_su_name" text="显示名称" font="6" textcolor="{tok:Ink}" width="0" align="center"/>
                <Text name="hdr_su_status" text="状态" font="6" textcolor="{tok:Ink}" width="90" align="center"/>
                <Text name="hdr_su_type" text="启动类型" font="6" textcolor="{tok:Ink}" width="118" align="center"/>
                <!-- [R105] 服务搜索过滤 -->
                <Edit name="svc_filter" width="110" height="32" tipvalue="搜索服务" tipvaluecolor="{tok:InkMuted}" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" bordercolor="{tok:Border}" bordersize="1" textpadding="6,3,6,3" font="1" borderround="4,4"/>
              </HorizontalLayout>
              <VerticalLayout name="svc_list" width="0" height="0" bkcolor="{tok:Surface}" childpadding="0" vscrollbar="true" borderround="8,8"/>
            </VerticalLayout>


            <Include source="pages/inc_task_panel.xml"/>

          </TabLayout>

          <!-- bottom bar -->
          <HorizontalLayout name="page_startup_L49" height="50" bkcolor="{tok:Surface}" inset="14,0,14,0" childpadding="10" childvalign="vcenter" borderround="8,8">
            <BoxCheck name="startup_hide_disabled" text="隐藏禁用项" font="1" textcolor="{tok:Ink}" borderround="4,4"/>
            <Control width="0"/>
            <Button name="btn_startup_add" text="添加启动项" font="1" textcolor="{tok:OnAccent}" bkcolor="{tok:Accent}" hotbkcolor="{tok:AccentHot}" height="32" width="110" borderround="4,4"/> <Button name="btn_startup_refresh" text="刷新" font="1" textcolor="{tok:OnAccent}" bkcolor="{tok:Accent}" hotbkcolor="{tok:AccentHot}" borderround="4,4" pushedbkcolor="{tok:AccentPushed}" width="100" height="32" align="center" valign="center"/>
          </HorizontalLayout>
        </VerticalLayout>
</Window>
