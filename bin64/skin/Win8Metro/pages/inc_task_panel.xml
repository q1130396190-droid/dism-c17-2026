<?xml version="1.0" encoding="utf-8"?>
<Window>
<VerticalLayout name="task_panel" inset="0,0,0,0" childpadding="0">

          <HorizontalLayout name="inc_task_panel_L5" height="40" bkcolor="{tok:Surface}" inset="16,0,0,0" childpadding="24" childvalign="vcenter" borderround="8,8">

            <Option name="tasktab_0" group="task_tab" text="所有任务" font="2" textcolor="{tok:InkTertiary}" selectedtextcolor="{tok:AccentText}" bkcolor="#00000000" width="120" height="40" align="left" selected="true"/>

            <Option name="tasktab_1" group="task_tab" text="已禁用任务" font="2" textcolor="{tok:InkTertiary}" selectedtextcolor="{tok:AccentText}" bkcolor="#00000000" width="120" height="40" align="left"/>

            <Option name="tasktab_2" group="task_tab" text="即将运行" font="2" textcolor="{tok:InkTertiary}" selectedtextcolor="{tok:AccentText}" bkcolor="#00000000" width="120" height="40" align="left"/>

          </HorizontalLayout>

          <Control height="1" bkcolor="{tok:BorderSoft}"/>

          <HorizontalLayout name="inc_task_panel_L17" height="34" bkcolor="{tok:SurfaceAlt}" inset="16,4,16,4" childpadding="8" childvalign="vcenter" borderround="8,8">

            <Text text="搜索" font="1" textcolor="{tok:InkSecondary}" width="48" valign="vcenter"/>

            <Edit name="task_filter" width="0" height="32" tipvalue="输入任务名称过滤（不区分大小写）" tipvaluecolor="{tok:InkMuted}" textcolor="{tok:Ink}" font="1" bkcolor="{tok:Surface}" bordercolor="{tok:Border}" bordersize="1" textpadding="6,4,6,4" borderround="4,4"/>

            <Text name="task_count" text="" font="1" textcolor="{tok:InkTertiary}" autocalcwidth="true" valign="vcenter"/>

          </HorizontalLayout>

          <Text name="task_infobar" text="" font="1" textcolor="{tok:AccentText}" bkcolor="{tok:SurfaceAlt}" height="26" align="left" valign="vcenter" textpadding="16,4,8,4" endellipsis="true"/>

          <TabLayout name="task_pages" width="0" height="0">

            <VerticalLayout inset="14,6,14,0" childpadding="0">

              <HorizontalLayout name="inc_task_panel_L33" height="28" bkcolor="{tok:SurfaceSunk}" childvalign="vcenter" borderround="8,8">

                <Text name="hdr_task_name" text="任务名称" font="6" textcolor="{tok:Ink}" width="300" align="center"/>

                <Text name="hdr_task_next" text="下次运行时间" font="6" textcolor="{tok:Ink}" width="180" align="center"/>

                <Text name="hdr_task_mode" text="任务模式" font="6" textcolor="{tok:Ink}" width="120" align="center"/>

                <Text name="hdr_task_status" text="状态" font="6" textcolor="{tok:Ink}" width="100" align="center"/>

                <Text name="hdr_task_user" text="运行用户" font="6" textcolor="{tok:Ink}" width="0" align="center"/>

              </HorizontalLayout>

              <VerticalLayout name="task_list" width="0" height="0" bkcolor="{tok:Surface}" childpadding="0" vscrollbar="true" borderround="8,8"/>

            </VerticalLayout>

          </TabLayout>

          <HorizontalLayout name="inc_task_panel_L53" height="50" bkcolor="{tok:Surface}" inset="14,0,14,0" childpadding="10" childvalign="vcenter" borderround="8,8">

            <Button name="btn_task_enable" text="启用" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="80" height="32" align="center" valign="center" borderround="4,4"/>

            <Button name="btn_task_disable" text="禁用" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="80" height="32" align="center" valign="center" borderround="4,4"/>

            <Button name="btn_task_run" text="立即运行" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="90" height="32" align="center" valign="center" borderround="4,4"/>

            <Button name="btn_task_delete" text="删除" font="1" textcolor="{tok:Ink}" bkcolor="{tok:Surface}" hotbkcolor="{tok:SurfaceHover}" pushedbkcolor="{tok:SurfaceHover}" bordercolor="{tok:Border}" bordersize="1" width="80" height="32" align="center" valign="center" borderround="4,4"/>

            <Control width="0"/>

            <Button name="btn_task_refresh" text="刷新" font="1" textcolor="{tok:OnAccent}" bkcolor="{tok:Accent}" hotbkcolor="{tok:AccentHot}" borderround="4,4" pushedbkcolor="{tok:AccentPushed}" width="100" height="32" align="center" valign="center"/>

          </HorizontalLayout>

        </VerticalLayout>
</Window>
