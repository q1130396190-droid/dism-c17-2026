<?xml version="1.0" encoding="utf-8"?>
<Window>
<VerticalLayout name="page_intl" inset="14,6,14,0" childpadding="10">
          <HorizontalLayout name="cl_31" height="30" bkcolor="#FFEFF6FC" childvalign="vcenter">
            <Text name="lbl_intl_title" text="时区设置" font="6" textcolor="#FF333333" width="120" align="center"/>
            <Text name="lbl_intl_cur" text="" font="1" textcolor="#FF666666" width="0" align="left"/>
          </HorizontalLayout>
          <Control height="1" bkcolor="#FFE5E5E5"/>
          <HorizontalLayout name="cl_32" height="34" childpadding="8" childvalign="vcenter">
            <Text text="选择时区" font="1" textcolor="#FF1A1A1A" width="80" align="left"/>
            <Combo name="intl_tzcombo" width="420" height="28" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF"/>
          </HorizontalLayout>
          <HorizontalLayout name="cl_33" height="34" childpadding="8" childvalign="vcenter">
            <Control width="0"/>
            <Button name="btn_intl_apply" text="应用时区" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" pushedbkcolor="#FF005A9E" borderround="4,4" height="28" width="100"/>
          </HorizontalLayout>

          <Control height="1" bkcolor="#FFE5E5E5"/>
          <HorizontalLayout name="cl_34" height="34" childpadding="8" childvalign="vcenter">
            <Text text="用户区域" font="1" textcolor="#FF1A1A1A" width="80" align="left"/>
            <Combo name="intl_loccombo" width="420" height="28" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF"/>
          </HorizontalLayout>
          <HorizontalLayout name="cl_35" height="34" childpadding="8" childvalign="vcenter">
            <Control width="0"/>
            <Button name="btn_intl_apply_loc" text="应用用户区域" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" pushedbkcolor="#FF005A9E" borderround="4,4" height="28" width="120"/>
          </HorizontalLayout>

          <Control height="1" bkcolor="#FFE5E5E5"/>
          <HorizontalLayout name="cl_36" height="34" childpadding="8" childvalign="vcenter">
            <Text text="系统区域" font="1" textcolor="#FF1A1A1A" width="80" align="left"/>
            <Combo name="intl_sysloccombo" width="420" height="28" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF"/>
          </HorizontalLayout>
          <HorizontalLayout name="cl_37" height="34" childpadding="8" childvalign="vcenter">
            <Control width="0"/>
            <Button name="btn_intl_apply_sysloc" text="应用系统区域" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" pushedbkcolor="#FF005A9E" borderround="4,4" height="28" width="120"/>
          </HorizontalLayout>

          <Control height="1" bkcolor="#FFE5E5E5"/>
          <HorizontalLayout name="cl_38" height="34" childpadding="8" childvalign="vcenter">
            <Text text="UI 语言" font="1" textcolor="#FF1A1A1A" width="80" align="left"/>
            <Combo name="intl_uilangcombo" width="420" height="28" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF"/>
          </HorizontalLayout>
          <HorizontalLayout name="cl_39" height="34" childpadding="8" childvalign="vcenter">
            <Control width="0"/>
            <Button name="btn_intl_apply_uilang" text="应用 UI 语言" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" pushedbkcolor="#FF005A9E" borderround="4,4" height="28" width="120"/>
          </HorizontalLayout>
          <Control height="1" bkcolor="#FFE5E5E5"/>
          <HorizontalLayout name="cl_41" height="34" childpadding="8" childvalign="vcenter">
            <Text text="已安装语言" font="1" textcolor="#FF1A1A1A" width="80" align="left"/>
            <Combo name="intl_instlangcombo" width="420" height="28" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF"/>
            <Control width="8"/>
            <Button name="btn_intl_remove_lang" text="删除语言" font="1" textcolor="#FF007ACC" bkcolor="#FFEEF4FB" hotbkcolor="#FFDCE9F7" bordercolor="#FFB8D0F0" bordersize="1" height="28" width="100"/>
          </HorizontalLayout>
          <HorizontalLayout name="cl_42" height="34" childpadding="8" childvalign="vcenter">
            <Text text="可安装语言" font="1" textcolor="#FF1A1A1A" width="80" align="left"/>
            <Combo name="intl_addlangcombo" width="420" height="28" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF"/>
            <Control width="8"/>
            <Button name="btn_intl_add_lang" text="安装语言" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" pushedbkcolor="#FF005A9E" borderround="4,4" height="28" width="100"/>
          </HorizontalLayout>

          <!-- [R120-1] 系统区域格式：短日期 / 短时间 / 十进制 / 货币 -->
          <Control height="1" bkcolor="#FFE5E5E5"/>
          <HorizontalLayout name="cl_43" height="34" childpadding="8" childvalign="vcenter">
            <Text text="短日期格式" font="1" textcolor="#FF1A1A1A" width="80" align="left"/>
            <Combo name="intl_shortdatecombo" width="300" height="28" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF"/>
            <Control width="8"/>
            <Button name="btn_intl_apply_shortdate" text="应用" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" pushedbkcolor="#FF005A9E" borderround="4,4" height="28" width="60"/>
          </HorizontalLayout>
          <HorizontalLayout name="cl_44" height="34" childpadding="8" childvalign="vcenter">
            <Text text="短时间格式" font="1" textcolor="#FF1A1A1A" width="80" align="left"/>
            <Combo name="intl_shorttimecombo" width="300" height="28" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF"/>
            <Control width="8"/>
            <Button name="btn_intl_apply_shorttime" text="应用" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" pushedbkcolor="#FF005A9E" borderround="4,4" height="28" width="60"/>
          </HorizontalLayout>
          <HorizontalLayout name="cl_45" height="34" childpadding="8" childvalign="vcenter">
            <Text text="十进制符号" font="1" textcolor="#FF1A1A1A" width="80" align="left"/>
            <Combo name="intl_decimalcombo" width="300" height="28" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF"/>
            <Control width="8"/>
            <Button name="btn_intl_apply_decimal" text="应用" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" pushedbkcolor="#FF005A9E" borderround="4,4" height="28" width="60"/>
          </HorizontalLayout>
          <HorizontalLayout name="cl_46" height="34" childpadding="8" childvalign="vcenter">
            <Text text="货币符号" font="1" textcolor="#FF1A1A1A" width="80" align="left"/>
            <Combo name="intl_currencycombo" width="300" height="28" font="1" textcolor="#FF1A1A1A" bkcolor="#FFFFFFFF"/>
            <Control width="8"/>
            <Button name="btn_intl_apply_currency" text="应用" font="1" textcolor="#FFFFFFFF" bkcolor="#FF007ACC" hotbkcolor="#FF1C97EA" pushedbkcolor="#FF005A9E" borderround="4,4" height="28" width="60"/>
          </HorizontalLayout>
        </VerticalLayout>
</Window>
